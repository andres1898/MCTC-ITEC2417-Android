// if/else statement are the same as in Java
fun main() {
    val trafficLightColor = "Black"

    if (trafficLightColor == "Red") { //evaluation
        println("Stop") //output
    } else if (trafficLightColor == "Yellow") {
        println("Slow")
    } else if (trafficLightColor == "Green") {
        println("Go")
    } else {
        println("Invalid traffic-light color")
    }

}

//when statements, new, no Java nor python have them
fun main() {
    val trafficLightColor = "Yellow"
//used mostly to assign a valur gived a condition or rules
    when (trafficLightColor) { //execute the action based on trafficLightColor value
        "Red" -> println("Stop")
        "Yellow" -> println("Slow")
        "Green" -> println("Go")
        else -> println("Invalid traffic-light color")
    }
}

