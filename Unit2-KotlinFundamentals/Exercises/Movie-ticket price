fun main() {
    val child = 5
    val adult = 28
    val senior = 87
    
    val isMonday = true
    
    var price = ticketPrice(child, isMonday)    
    println("The movie ticket price for a person aged $child is \$$price.")
    
    price = ticketPrice(adult, isMonday)
    println("The movie ticket price for a person aged $adult is \$$price.")
    
    price = ticketPrice(senior, isMonday)
    println("The movie ticket price for a person aged $senior is \$$price.")
    
}

fun ticketPrice(age: Int, isMonday: Boolean): Int {
    // Fill in the code.
    var price: Int
    
    if (age < 12) {
        price = 15
    } else if (13 < age && age < 60) {
        price = 30
        if (isMonday) {
            price = price - 5
        }
    } else if (61 < age && age < 100) {
        price = 20
    } else {price = -1}
    
    return price
    
    
}

fun ticketPriceLambda(age: Int, isMonday: Boolean): Int { // it takes an Int and Boolean and return an Integer
    return when(age) { //return instead of creating temp variable. When statement bc is a list of conditions
        in 0..12 -> 15 //create a range with the synthax "in int..int" assigns a value with ->
        in 13..60 -> if (isMonday) 25 else 30 //condition in lambda format, "if (condition) true-action else false-action"
        in 61..100 -> 20
        else -> -1 //final of the list
    }
}
